# Sao chep file nay thanh .env roi dieu chinh gia tri
NODE_ENV=development
API_PORT=3000

MONGODB_URI=mongodb://localhost:27017/petmory?replicaSet=rs0&directConnection=true
# Muon dung co so du lieu tren mang thi doc huong dan trong docs/DUA-DATABASE-LEN-MANG.md

# Khoa ky JWT - bat buoc doi truoc khi chay that
JWT_ACCESS_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_REFRESH_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Thu muc luu anh o che do demo
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# Noi luu anh: de trong hoac dat disk thi luu tren o dia may nay.
# Dat cloudinary thi phai dien du ba khoa ben duoi. Doc docs/KE-HOACH-CLOUDINARY.md
STORAGE_DRIVER=disk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNED_URL_TTL=600

WEB_ORIGIN=http://localhost:4200

# --- Gui thu (khoi phuc mat khau) ---
# De trong SMTP_HOST thi khong gui thu; o moi truong phat trien duong dan dat lai
# mat khau duoc ghi ra nhat ky may chu de van thu duoc.
SMTP_HOST=
SMTP_PORT=587
# true khi dung cong 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Petmory <no-reply@petmory.local>

# Tri tue nhan tao. AI_PROVIDER: gemini hoac anthropic; de trong thi tu chon theo khoa dang co.
# Khong co khoa nao thi cac chuc nang AI chay bang bo tra loi mau.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# De trong de dung mac dinh: gemini-3.5-flash-lite hoac claude-opus-5.
AI_MODEL=
# Noi sua anh cho phuc hoi anh (tach nen, tang chi tiet mat): cloudinary hoac gemini.
# De trong thi dung Cloudinary neu da cau hinh (chay duoc tren goi mien phi), khong thi dung Gemini.
AI_IMAGE_PROVIDER=
# Mo hinh sua anh khi dung Gemini (can project da bat thanh toan). De trong: gemini-2.5-flash-image.
AI_IMAGE_MODEL=
AI_TIMEOUT_MS=45000

# Sao chep file nay thanh .env roi dieu chinh gia tri
NODE_ENV=development
API_PORT=3000

MONGODB_URI=mongodb://localhost:27017/petmory?replicaSet=rs0&directConnection=true
# Muon dung co so du lieu tren mang thi doc huong dan trong docs/DUA-DATABASE-LEN-MANG.md

# Khoa ky JWT - bat buoc doi truoc khi chay that
JWT_ACCESS_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_REFRESH_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Thu muc luu anh o che do demo
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# Noi luu anh: de trong hoac dat disk thi luu tren o dia may nay.
# Dat cloudinary thi phai dien du ba khoa ben duoi. Doc docs/KE-HOACH-CLOUDINARY.md
STORAGE_DRIVER=disk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNED_URL_TTL=600

WEB_ORIGIN=http://localhost:4200

# --- Gui thu (khoi phuc mat khau) ---
# De trong SMTP_HOST thi khong gui thu; o moi truong phat trien duong dan dat lai
# mat khau duoc ghi ra nhat ky may chu de van thu duoc.
SMTP_HOST=
SMTP_PORT=587
# true khi dung cong 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Petmory <no-reply@petmory.local>

# --- SePay: xac nhan chuyen khoan ---
# Khoa cua webhook. Dat cung gia tri trong SePay > Webhooks > Kieu chung thuc "API Key".
# Bat buoc, khong co gia tri mac dinh. Tao chuoi ngau nhien dai, vi du:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEPAY_WEBHOOK_KEY=change-this-key-before-running
# Token API cua SePay (SePay > Cau hinh cong ty > API Access), dung cho nut "Doi soat SePay".
# De trong thi tat doi soat; webhook van chay.
SEPAY_API_TOKEN=
# Mac dinh https://my.sepay.vn/userapi
SEPAY_API_BASE=
# IP duoc goi webhook, cach nhau dau phay. De trong thi khong kiem IP.
# Chi bat khi API thay IP that cua nguoi goi (khong dung sau proxy chua cau hinh).
# IP cua SePay theo tai lieu: 172.236.138.20,172.233.83.68,171.244.35.2,151.158.108.68,151.158.109.79,103.255.238.139,45.57.137.67
SEPAY_ALLOWED_IPS=

# Tri tue nhan tao. AI_PROVIDER: gemini hoac anthropic; de trong thi tu chon theo khoa dang co.
# Khong co khoa nao thi cac chuc nang AI chay bang bo tra loi mau.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# De trong de dung mac dinh: gemini-3.5-flash-lite hoac claude-opus-5.
AI_MODEL=
# Mo hinh sua anh cua Gemini cho phuc hoi anh (tach nen, tang chi tiet mat). De trong: gemini-2.5-flash-image.
AI_IMAGE_MODEL=
AI_TIMEOUT_MS=45000

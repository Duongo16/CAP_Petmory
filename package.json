{
  "name": "petmory",
  "version": "0.1.0",
  "private": true,
  "description": "PETMORY - luu giu ky niem thu cung bang san pham thu cong tuy bien",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "api": "npm run start:dev --workspace apps/api",
    "web": "npm run start --workspace apps/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run api\" \"npm run web\"",
    "seed": "npm run seed --workspace apps/api",
    "account:make": "node tools/make-account.js",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/api",
    "docs:contracts": "node docs/contracts/build-docx.js",
    "test:integration": "node tools/integration/run-all.js",
    "test:mobile": "node tools/test-mobile-ui.js",
    "test:recovery": "node tools/test-password-recovery.js",
    "test:models": "node tools/check-models.js",
    "db:check": "node tools/check-db.js",
    "test:i18n": "node tools/check-i18n-keys.js",
    "test:templates": "node tools/check-template-deps.js",
    "storage:check": "node tools/check-storage.js",
    "figma:coverage": "node tools/check-figma-coverage.js",
    "pictures:move": "node tools/move-pictures.js",
    "shot": "node tools/shot.js",
    "test:ui": "node tools/run-ui-tests.js",
    "test:photoedit": "node tools/test-photo-edit.js",
    "test:diary": "node tools/test-diary-api.js",
    "test:book": "node tools/test-diary-book-ui.js",
    "test:diaryui": "node tools/test-diary-ui.js",
    "test:goods": "node tools/test-goods-api.js",
    "seed:goods": "node tools/seed-goods.js",
    "goods:images": "node tools/make-goods-images.js",
    "test:reports": "node tools/test-reports-api.js",
    "test:ai": "node tools/test-ai-api.js",
    "test:aiui": "node tools/test-ai-ui.js",
    "ui:tokens": "node tools/check-design-system.js",
    "ui:layout": "node tools/measure-layout.js",
    "ui:overlap": "node tools/check-overlap.js",
    "ui:contrast": "node tools/check-contrast.js",
    "ui:shots": "node tools/shot-all-screens.js",
    "seed:demo": "node tools/seed-demo-customer.js",
    "test:roles": "node tools/test-roles-api.js",
    "roles:migrate": "node tools/migrate-roles.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "docx": "^9.5.1",
    "playwright": "^1.63.0"
  }
}
